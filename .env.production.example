# App
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NODE_ENV="production"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Database
# Vercel application runtime: Supabase Transaction Pooler (port 6543).
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DB_POOL_MAX="2"

# Prisma migration/admin tooling only: use an approved direct or session connection.
# Do not expose this value to browser code or use the transaction pooler for migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Payments
STRIPE_SECRET_KEY="sk_live_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"
RAZORPAY_KEY_ID="rzp_live_replace"
RAZORPAY_KEY_SECRET="replace"
RAZORPAY_WEBHOOK_SECRET="replace"
MERCHANT_UPI_ID="merchant@upi"

# Email
RESEND_API_KEY="re_live_replace"
AUTH_EMAIL_FROM="Zylo-Buylo <noreply@zylo-buylo.com>"

# WhatsApp Cloud API order notifications (optional)
# Requires an approved template with body variables:
# 1 customer name, 2 order id, 3 order total.
WHATSAPP_ACCESS_TOKEN="replace"
WHATSAPP_PHONE_NUMBER_ID="replace"
WHATSAPP_ORDER_TEMPLATE="order_confirmation"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# Upload storage
# Use the Supabase project URL and service role key. Keep service role key server-only.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="zylo-buylo-uploads"
