# App
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NODE_ENV="production"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# Database
# Recommended for Vercel: Supabase Postgres pooled connection string.
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Payments
STRIPE_SECRET_KEY="sk_live_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"
RAZORPAY_KEY_ID="rzp_live_replace"
RAZORPAY_KEY_SECRET="replace"
RAZORPAY_WEBHOOK_SECRET="replace"
