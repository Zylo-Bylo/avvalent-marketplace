generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  UPI
  RAZORPAY
  STRIPE
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum BankVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutStatus {
  PENDING
  ON_HOLD
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum PayoutMethod {
  BANK_TRANSFER
  UPI
  RAZORPAYX
  MANUAL
}

enum LedgerEntryType {
  ORDER_PENDING
  ORDER_AVAILABLE
  COMMISSION_DEBIT
  REFUND_DEBIT
  PENALTY_DEBIT
  PAYOUT_DEBIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum CommissionRuleType {
  GLOBAL
  CATEGORY
  VENDOR
}

enum SettlementReportStatus {
  DRAFT
  GENERATED
  PAID
  CANCELLED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  CRITICAL_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  BACKORDER
}

enum StockMovementType {
  STOCK_ADDED
  STOCK_REMOVED
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  MANUAL_ADJUSTMENT
  RESERVED
  RESERVATION_RELEASED
}

enum StockReservationStatus {
  RESERVED
  CONVERTED
  RELEASED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  role          UserRole       @default(CUSTOMER)
  avatarUrl     String?
  emailVerified Boolean        @default(false)
  emailOtpHash   String?
  emailOtpExpiresAt DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendorProfile Vendor?
  orders        Order[]
  wishlist      Wishlist[]
  reviews       Review[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  stockAdjustments StockMovement[]
  authIdentityMapping AuthIdentityMapping?
}

model AuthIdentityMapping {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  authUserId String   @unique
  provider   String   @default("supabase")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([provider])
}

model Vendor {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String    @unique
  storeName        String
  description      String?
  logoUrl          String?
  mobile           String?
  businessCategory String?
  businessAddress  String?
  gstNumber        String?
  panNumber        String?
  aadhaarNumber    String?
  bankDetails      String?
  upiId            String?
  documentsKyc     String?
  metadata         Json?
  panCardUrl       String?
  aadhaarUrl       String?
  gstCertificateUrl String?
  bankProofUrl     String?
  status           VendorStatus @default(PENDING)
  kycStatus        KycStatus @default(NOT_SUBMITTED)
  rejectionReason  String?
  approvedAt       DateTime?
  workingHours     String?
  deliveryArea     String?
  products         Product[]
  orders           Order[]
  bankAccounts     VendorBankAccount[]
  wallet           VendorWallet?
  payouts          VendorPayout[]
  ledgerEntries    VendorLedger[]
  commissionRules  CommissionRule[]
  settlementReports SettlementReport[]
  refundAdjustments RefundAdjustment[]
  inventories      Inventory[]
  stockMovements   StockMovement[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([kycStatus])
  @@index([createdAt])
}

model Category {
  id              String        @id @default(cuid())
  name            String        @unique
  slug            String        @unique
  status          String        @default("ACTIVE")
  sortOrder       Int           @default(0)
  homepageIcon    String?
  categoryImage   String?
  desktopBanner   String?
  mobileBanner    String?
  altText         String?
  archivedAt      DateTime?
  products        Product[]
  subcategories   Subcategory[]
  commissionRules CommissionRule[]

  @@index([status])
  @@index([sortOrder])
}

model Subcategory {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  status         String        @default("ACTIVE")
  sortOrder      Int           @default(0)
  homepageIcon   String?
  categoryImage  String?
  desktopBanner  String?
  mobileBanner   String?
  altText        String?
  archivedAt     DateTime?
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  products       Product[]
  productTypes   ProductType[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
}

model ProductType {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  status         String       @default("ACTIVE")
  sortOrder      Int          @default(0)
  homepageIcon   String?
  categoryImage  String?
  desktopBanner  String?
  mobileBanner   String?
  altText        String?
  archivedAt     DateTime?
  subcategory    Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  subcategoryId  String
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([subcategoryId, name])
  @@index([subcategoryId])
  @@index([status])
  @@index([sortOrder])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Float
  mrp         Float?
  vendorPrice Float?
  sellingPrice Float?
  discountPercent Float       @default(0)
  discountAmount Float        @default(0)
  platformCommissionPercent Float @default(10)
  platformCommissionAmount Float  @default(0)
  packagingCharge Float       @default(0)
  weightGrams Float?
  packageSize String?
  fragile     Boolean         @default(false)
  shippingCharge Float        @default(0)
  codCharge   Float           @default(0)
  finalCustomerPrice Float?
  vendorPayout Float?
  priceApproved Boolean       @default(false)
  offerStartDate DateTime?
  offerEndDate DateTime?
  sku         String?     @unique
  images      Json
  inventory   Int         @default(0)
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  vendorId    String
  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  String?
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId String?
  productType ProductType? @relation(fields: [productTypeId], references: [id])
  productTypeId String?
  reviews     Review[]
  orderItems  OrderItem[]
  variants    ProductVariant[]
  wishlists   Wishlist[]
  inventories Inventory[]
  stockMovements StockMovement[]
  stockReservations StockReservation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([productTypeId])
  @@index([inventory])
  @@index([price])
  @@index([discountPercent])
  @@index([createdAt])
  @@index([updatedAt])
}

model CategoryAuditLog {
  id         String   @id @default(cuid())
  adminUser  String
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model ProductVariant {
  id                String   @id @default(cuid())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  sizeLabel         String?
  numericSize       String?
  color             String?
  sku               String?  @unique
  stockQuantity     Int      @default(0)
  price             Float?
  vendorPrice       Float?
  mrp               Float?
  imageUrl          String?
  status            String   @default("IN_STOCK")
  lowStockThreshold Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([status])
  @@index([stockQuantity])
}

model Inventory {
  id                       String      @id @default(cuid())
  product                  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId                String
  vendor                   Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId                 String
  sku                      String?
  mpn                      String?
  currentStock             Int         @default(0)
  reservedStock            Int         @default(0)
  availableStock           Int         @default(0)
  lowStockThreshold        Int         @default(10)
  criticalStockThreshold   Int         @default(3)
  minimumOrderQuantity     Int         @default(1)
  maximumOrderQuantity     Int?
  restockDate              DateTime?
  stockStatus              StockStatus @default(IN_STOCK)
  allowBackorder           Boolean     @default(false)
  isPreOrder               Boolean     @default(false)
  bulkPricingTiers         Json?
  lastLowStockAlertAt      DateTime?
  lastCriticalStockAlertAt DateTime?
  lastStockUpdatedAt       DateTime    @default(now())
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([productId])
  @@index([vendorId])
  @@index([sku])
  @@index([mpn])
  @@index([stockStatus])
}

model StockMovement {
  id               String            @id @default(cuid())
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId         String
  type             StockMovementType
  quantity         Int
  oldStock         Int
  newStock         Int
  reason           String?
  order            Order?            @relation(fields: [orderId], references: [id])
  orderId          String?
  adjustedBy       User?             @relation(fields: [adjustedByUserId], references: [id])
  adjustedByUserId String?
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([vendorId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model Order {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  vendor        Vendor?      @relation(fields: [vendorId], references: [id])
  vendorId      String?
  totalAmount   Float
  status        OrderStatus  @default(PENDING)
  paymentMethod PaymentMethod
  paymentId     String?
  shippingName  String?
  shippingPhone String?
  shippingAddress String?
  shippingCity  String?
  shippingState String?
  shippingZipCode String?
  trackingNumber String?
  carrier       String?
  statusNote    String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  items         OrderItem[]
  ledgerEntries VendorLedger[]
  refundAdjustments RefundAdjustment[]
  stockMovements StockMovement[]
  stockReservations StockReservation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentId])
  @@index([createdAt])
  @@index([updatedAt])
}

model StockReservation {
  id        String                 @id @default(cuid())
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  order     Order?                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String?
  quantity  Int
  status    StockReservationStatus @default(RESERVED)
  expiresAt DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
}

model VendorBankAccount {
  id                 String                 @id @default(cuid())
  vendor             Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId           String
  accountHolderName  String
  bankName           String
  accountNumber      String
  ifscCode           String
  upiId              String?
  panNumber          String
  gstNumber          String?
  verificationStatus BankVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  payouts            VendorPayout[]

  @@index([vendorId])
}

model VendorWallet {
  id                 String   @id @default(cuid())
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId           String   @unique
  grossSales         Float    @default(0)
  commissionDeducted Float    @default(0)
  refundDeducted     Float    @default(0)
  penaltyDeducted    Float    @default(0)
  availableBalance   Float    @default(0)
  pendingBalance     Float    @default(0)
  paidBalance        Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VendorPayout {
  id                String       @id @default(cuid())
  vendor            Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId          String
  payoutAmount      Float
  payoutStatus      PayoutStatus @default(PENDING)
  payoutMethod      PayoutMethod @default(BANK_TRANSFER)
  bankAccount       VendorBankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId     String?
  transactionId     String?
  failureReason     String?
  approvedByAdminId String?
  approvedAt        DateTime?
  paidAt            DateTime?
  requestedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([vendorId])
  @@index([payoutStatus])
}

model VendorLedger {
  id            String          @id @default(cuid())
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId      String
  order         Order?          @relation(fields: [orderId], references: [id])
  orderId       String?
  type          LedgerEntryType
  creditAmount  Float           @default(0)
  debitAmount   Float           @default(0)
  balanceAfter  Float           @default(0)
  note          String?
  createdAt     DateTime        @default(now())

  @@index([vendorId])
  @@index([orderId])
}

model CommissionRule {
  id                String             @id @default(cuid())
  type              CommissionRuleType
  category          Category?          @relation(fields: [categoryId], references: [id])
  categoryId        String?
  vendor            Vendor?            @relation(fields: [vendorId], references: [id])
  vendorId          String?
  commissionPercent Float
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([type])
  @@index([categoryId])
  @@index([vendorId])
}

model SettlementReport {
  id               String                 @id @default(cuid())
  vendor           Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId         String
  reportPeriod     String
  totalOrders      Int                    @default(0)
  grossAmount      Float                  @default(0)
  commissionAmount Float                  @default(0)
  refundAmount     Float                  @default(0)
  netPayable       Float                  @default(0)
  status           SettlementReportStatus @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([vendorId])
  @@index([reportPeriod])
}

model RefundAdjustment {
  id                 String   @id @default(cuid())
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId           String
  order              Order?   @relation(fields: [orderId], references: [id])
  orderId            String?
  refundAmount       Float
  reason             String?
  adjustedFromPayout Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([vendorId])
  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  variantId String?
  sizeLabel String?
  numericSize String?
  variantColor String?
  variantSku String?
  quantity  Int
  price     Float
  mrp       Float?
  vendorPrice Float?
  platformCommissionAmount Float?
  packagingCharge Float?
  shippingCharge Float?
  vendorPayout Float?

  @@index([orderId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
