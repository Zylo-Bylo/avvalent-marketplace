{
  "name": "zylo-buylo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-schema.mjs generate && next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run lint && npm run test:coverage && npm run build",
    "postinstall": "node scripts/prisma-schema.mjs generate",
    "prisma:generate": "node scripts/prisma-schema.mjs generate",
    "prisma:db:push": "node scripts/prisma-schema.mjs db push",
    "vercel-build": "node scripts/prisma-schema.mjs generate && next build",
    "seed": "node scripts/prisma-schema.mjs generate && npx tsx seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.4",
    "prisma": "^7.8.0",
    "razorpay": "^2.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^12.0.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
